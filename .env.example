# Copy to .env.local and fill in. Never commit real values.
# Vercel: set the same names under Project -> Settings -> Environment Variables.

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017
# This app uses only product_hub (tests: product_hub_selftest). Never point it at meesho-admin.
MONGODB_DB_NAME=product_hub

# --- Cloudinary (server-side only; never prefix with NEXT_PUBLIC_) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=product-hub

# --- AI: screenshot reader and listing writer (server-side only; leave both keys empty to turn AI off) ---
# Google Gemini (used first): key from https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Optional: force one Gemini model (default tries gemini-3.5-flash, then gemini-flash-latest)
GEMINI_MODEL=
# Optional: Gemini API base URL (default https://generativelanguage.googleapis.com)
GEMINI_BASE_URL=
# Anthropic Claude (used only when GEMINI_API_KEY is empty): https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Optional: Anthropic API base URL (default https://api.anthropic.com)
ANTHROPIC_BASE_URL=

# --- Authentication ---
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Also the root key for encrypted temporary passwords and signed preview tokens; changing it invalidates both.
AUTH_SECRET=replace-with-a-long-random-secret
# Session lifetime in days (1-90, default 7)
SESSION_DAYS=7

# --- Public site ---
# Full URL of the deployed app, no trailing slash. Used for the login link in emails.
PUBLIC_BASE_URL=https://your-app-domain.example

# --- Payments ---
# razorpay (default) or mock. Live Razorpay keys only in Vercel Production (rzp_live_ keys are refused anywhere else).
# Local tests use: PAYMENT_MODE=mock ALLOW_MOCK_PAYMENTS=yes with a *_selftest database.
# mock is refused on every Vercel environment, on any database not ending in
# _selftest/_security/_review/_test/_dev, and whenever RAZORPAY_KEY_ID is a live key.
PAYMENT_MODE=razorpay
# Razorpay Dashboard -> Account & Settings -> API Keys (use rzp_test_ keys outside Production)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Razorpay Dashboard -> Webhooks: the secret you typed when adding the /api/webhooks/razorpay webhook
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- Email (GoDaddy SMTP) ---
SMTP_HOST=smtpout.secureserver.net
# 465 = implicit TLS (default); 587 = STARTTLS
SMTP_PORT=465
# true for 465, false for 587 (left empty, it follows the port)
SMTP_SECURE=true
# Mailbox login, usually the same address as MAIL_FROM
SMTP_USER=you@your-domain.example
SMTP_PASSWORD=your-mailbox-password
# Sender address and display name
MAIL_FROM=you@your-domain.example
MAIL_FROM_NAME=Product Hub
# Owner alerts (new purchase, payment needs review, coupon over limit); leave empty to skip them
NOTIFY_EMAIL=owner@your-domain.example
# Maximum emails sent in any 24 hours (default 200)
MAIL_DAILY_LIMIT=200

# --- Daily cron ---
# Long random string; the cron call must send "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=replace-with-a-long-random-secret

# --- Initial Admin (used only by `npm run seed:admin`; remove the password afterwards) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Tests only (scripts/test-authz.mjs); usually passed on the command line instead ---
# TEST_BASE_URL=http://localhost:3123
# TEST_ADMIN_EMAIL=admin@example.com
# TEST_ADMIN_PASSWORD=test-admin-password

# Every plan sees every product while the catalog is small. Set to `no` to bring
# back Starter's 2-category limit (also needed when running scripts/test-authz.mjs).
# OPEN_CATALOG=no
